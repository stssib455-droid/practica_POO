  <property name="styleSheet">
   <string>
QMainWindow, QWidget#centralwidget { background: #f1f5fb; }
QWidget { font-family: 'Segoe UI'; font-size: 10pt; color: #263950; }
QLabel#eyebrow { color: #3976cf; font-size: 9pt; }
QLabel#title { font-size: 25pt; color: #172e4d; font-weight: 700; }
QLabel#subtitle, QLabel#sceneHint, QLabel#footerLabel, QLabel#modelLabel { color: #7a879b; font-size: 9pt; }
QFrame#scenePanel, QFrame#controlPanel, QFrame#idCard, QFrame#flightCard, QFrame#altitudeCard, QFrame#batteryCard { background: white; border: 1px solid #dfe6f1; border-radius: 9px; }
QLabel#idValue, QLabel#flightValue, QLabel#altitudeValue, QLabel#batteryValue { font-size: 23pt; font-weight: 600; color: #2568ce; }
QLabel#idCaption, QLabel#flightCaption, QLabel#altitudeCaption, QLabel#batteryCaption { color: #7a879b; font-size: 9pt; }
QLabel#sceneTitle, QLabel#targetTitle { font-size: 12pt; font-weight: 600; }
QLabel#positionValue { color: #456287; }
QPushButton { background: white; border: 1px solid #d3deed; border-radius: 5px; padding: 7px 11px; }
QPushButton:hover { background: #edf3fe; border-color: #7da7eb; }
QPushButton#moveButton, QPushButton#takeoffButton { background: #3976ec; color: white; border: none; }
QPushButton#emergencyButton { background: #c9444a; color: white; border: none; padding: 11px; font-weight: 600; }
QDoubleSpinBox, QSpinBox { padding: 4px; background: white; border: 1px solid #d3deed; border-radius: 4px; }
QLabel#feedbackLabel { color: #315e99; }
QPlainTextEdit { background: #15263e; color: #d7e5fa; border: none; border-radius: 7px; padding: 6px; font-family: Consolas; font-size: 9pt; }
</string>
