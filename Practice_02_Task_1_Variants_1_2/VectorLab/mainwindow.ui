  <property name="styleSheet">
   <string>
QMainWindow, QWidget#centralwidget {background:#edf2f8;}
QWidget {font-family:"Segoe UI";font-size:9pt;color:#233652;}
QLabel#eyebrow {color:#5276aa;font-size:8pt;letter-spacing:1px;}
QLabel#title {font-size:25pt;font-weight:700;color:#142b4d;}
QLabel#subtitle, QLabel#inputNote, QLabel#feedbackLabel {color:#74849c;font-size:8pt;}
QFrame#mainCard, QFrame#extraCard, QFrame#statusCard, QFrame#controlPanel,
QFrame#sceneCard, QFrame#tableCard, QFrame#formulaCard {background:white;border:1px solid #dce5f1;border-radius:10px;}
QLabel#mainCaption, QLabel#extraCaption, QLabel#statusCaption {color:#74849c;font-size:8pt;}
QLabel#mainValue, QLabel#extraValue, QLabel#statusValue {font-size:21pt;font-weight:600;color:#1664b8;}
QLabel#mainHint, QLabel#extraHint, QLabel#statusHint {font-size:8pt;color:#74849c;}
QLabel#sceneTitle, QLabel#tableTitle, QLabel#formulaTitle {font-size:11pt;font-weight:600;}
QLabel#airTitle, QLabel#windTitle, QLabel#startTitle, QLabel#finishTitle {font-weight:600;}
QLabel#legendLabel, QLabel#velocityNote, QLabel#routeNote {font-size:8pt;color:#5c6f89;}
QPushButton {background:#f7faff;border:1px solid #cbd9eb;border-radius:6px;padding:7px 12px;}
QPushButton:hover {background:#e9f1fc;border-color:#8badd6;}
QPushButton#presetButton {background:#246ac4;color:white;border-color:#246ac4;}
QDoubleSpinBox, QComboBox {background:white;border:1px solid #cad8eb;border-radius:4px;padding:4px 3px;}
QDoubleSpinBox:focus, QComboBox:focus {border-color:#246ac4;}
QTabWidget::pane {border:0;background:white;}
QTabBar::tab {background:#edf2f8;color:#687d98;border-radius:5px;padding:8px 10px;margin:2px;}
QTabBar::tab:selected {background:#dceafa;color:#155eac;font-weight:600;}
QTableWidget {border:0;background:white;gridline-color:#edf2f8;alternate-background-color:#f6f9fd;selection-background-color:#e3eefb;selection-color:#142b4d;}
QHeaderView::section {background:#f1f5fb;color:#69809f;border:0;padding:5px;}
QSlider::groove:horizontal {height:4px;background:#e3eaf4;border-radius:2px;}
QSlider::handle:horizontal {background:#3577c8;width:12px;margin:-4px 0;border-radius:6px;}
</string>
  </property>
 </widget>
